# Server
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000

# ─── Database (local PostgreSQL) ────────────────────────────────────────────
DATABASE_URL=postgresql://cronos:cronos@localhost:5432/cronos
DIRECT_URL=postgresql://cronos:cronos@localhost:5432/cronos

# ─── Redis (required for email job queue) ───────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-secure-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-another-secure-random-string-min-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ───────────────────────────────────────────────────────────────────
WEB_URL=http://localhost:3000

# ─── SMTP (optional fallback — prefer Settings → SMTP in the app) ───────────
# If company SMTP is configured in the database, that is used instead.
# Google Workspace example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=hr@gyroitsolutions.com
# SMTP_PASS=your-google-app-password
# SMTP_FROM=hr@gyroitsolutions.com

# ─── Face Recognition Service ───────────────────────────────────────────────
FACE_SERVICE_URL=http://localhost:8000
