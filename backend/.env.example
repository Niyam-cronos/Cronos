# Server
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000

# ─── Database (local PostgreSQL) ────────────────────────────────────────────
DATABASE_URL=postgresql://cronos:cronos@localhost:5432/cronos
DIRECT_URL=postgresql://cronos:cronos@localhost:5432/cronos

# ─── Redis (required for email job queue) ───────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-secure-random-string-min-32-chars
JWT_REFRESH_SECRET=change-me-to-another-secure-random-string-min-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ───────────────────────────────────────────────────────────────────
WEB_URL=http://localhost:3000

# ─── SMTP (email sending) ───────────────────────────────────────────────────
# Dev: leave blank — emails log to console via JSON transport
# Prod: use Resend, SendGrid, Gmail, etc.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_your_api_key
# SMTP_FROM=noreply@yourdomain.com

# ─── Face Recognition Service ───────────────────────────────────────────────
FACE_SERVICE_URL=http://localhost:8000
